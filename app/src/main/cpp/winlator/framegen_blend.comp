#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D prevTex;
layout(set = 0, binding = 1) uniform sampler2D currTex;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dstImg;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(dstImg);
    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(outSize);
    vec4 prevColor = texture(prevTex, uv);
    vec4 currColor = texture(currTex, uv);
    imageStore(dstImg, coord, mix(prevColor, currColor, 0.5));
}
